APP_NAME="Consumer Product & Vehicle Safety API"
APP_ENV=development

# Agent framework: pydantic_ai (default) or langchain
AGENT_BACKEND=pydantic_ai
# Show the Pydantic AI / LangChain toggle in the web app (keep off in production)
ALLOW_BACKEND_SELECTION=true

# Required for /api/chat
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# JSON list tried in order when the primary model is busy; [] disables fallback
GEMINI_FALLBACK_MODELS=["gemini-3.6-flash","gemini-3.5-flash-lite"]
GEMINI_RETRY_ATTEMPTS=2
